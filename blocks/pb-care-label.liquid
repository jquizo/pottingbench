{%- liquid
  assign block_settings = block.settings
  assign care = closest.product.metafields.custom.care.value

  if block_settings.background_color != blank or block_settings.text_color != blank
    assign has_custom_colour = true
  endif

  assign light_label = 'pb_care_label.labels.light' | t
  assign water_label = 'pb_care_label.labels.water' | t
  assign humidity_label = 'pb_care_label.labels.humidity' | t
  assign pet_safety_label = 'pb_care_label.labels.pet_safety' | t
  assign difficulty_label = 'pb_care_label.labels.difficulty' | t
-%}

{%- if care != blank -%}
  {% render 'contrast-override',
    background_color: block_settings.background_color,
    text_color: block_settings.text_color,
    section_id: block.id
  %}

  <div
    class="pb-care-label spacing-style{% if has_custom_colour %} color-custom-{{ block.id }}{% endif %}"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.heading != blank -%}
      <h2 class="pb-care-label__heading h6">{{ block_settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if block_settings.show_botanical_name and care.botanical_name.value != blank -%}
      <p class="pb-care-label__botanical">{{ care.botanical_name.value | escape }}</p>
    {%- endif -%}

    <dl class="pb-care-label__list">
      {%- render 'pb-care-label-row', label: light_label, value: care.light.value -%}
      {%- render 'pb-care-label-row', label: water_label, value: care.water.value -%}
      {%- render 'pb-care-label-row', label: humidity_label, value: care.humidity.value -%}
      {%- if block_settings.show_pet_safety -%}
        {%- render 'pb-care-label-row', label: pet_safety_label, value: care.pet_safe.value -%}
      {%- endif -%}
      {%- render 'pb-care-label-row', label: difficulty_label, value: care.difficulty.value -%}
    </dl>
  </div>
{%- elsif request.design_mode -%}
  {% # Editor-only hint: products without a care entry (planters, supplies) show nothing to customers %}
  <p class="pb-care-label__hint" {{ block.shopify_attributes }}>
    {{ 'pb_care_label.editor_hint' | t }}
  </p>
{%- endif -%}

{% stylesheet %}
  .pb-care-label {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .pb-care-label__heading,
  .pb-care-label__botanical,
  .pb-care-label__list,
  .pb-care-label__value {
    margin: 0;
  }

  .pb-care-label__botanical {
    font-family: var(--font-heading--family);
  }

  .pb-care-label__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  /* Nursery-tag row: a thin outline with a heavier start edge */
  .pb-care-label__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-xs);
    padding-block: var(--padding-xs);
    padding-inline: var(--padding-sm);
    border: var(--style-border-width) solid rgb(var(--color-border-rgb) / var(--opacity-20));
    border-inline-start: 3px solid var(--color-border);
    border-radius: var(--style-border-radius-xs);
  }

  .pb-care-label__label {
    font-family: var(--font-accent--family);
    font-size: var(--font-size--2xs);
    letter-spacing: var(--letter-spacing-sm);
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .pb-care-label__hint {
    margin: 0;
    font-size: var(--font-size--sm);
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:pb_care_label.name",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:pb_care_label.content.data_source"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:pb_care_label.settings.heading",
      "default": "t:pb_care_label.defaults.heading"
    },
    {
      "type": "checkbox",
      "id": "show_botanical_name",
      "label": "t:pb_care_label.settings.show_botanical_name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pet_safety",
      "label": "t:pb_care_label.settings.show_pet_safety",
      "info": "t:pb_care_label.info.pet_safety",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:pb_care_label.name",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
